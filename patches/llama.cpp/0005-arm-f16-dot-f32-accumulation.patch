+    for (; i < n; ++i) {
+        sumf += (ggml_float) GGML_CPU_FP16_TO_FP32(x[i]) * (ggml_float) GGML_CPU_FP16_TO_FP32(y[i]);
+    }
+    *s = sumf;
+}
