+// Upstream's F16 multiply-adds over elements [i, end) and its F16 reduction.
+static inline float16x8_t ggml_vec_dot_f16_block(const ggml_fp16_t * GGML_RESTRICT x, const ggml_fp16_t * GGML_RESTRICT y, int i, int end) {
+    float16x8_t sum[4] = { vdupq_n_f16(0.0f), vdupq_n_f16(0.0f), vdupq_n_f16(0.0f), vdupq_n_f16(0.0f) };
+    for (; i < end; i += 32) {
+        for (int j = 0; j < 4; ++j) {
+            sum[j] = vfmaq_f16(sum[j], vld1q_f16((const __fp16 *) (x + i + 8*j)),
+                                       vld1q_f16((const __fp16 *) (y + i + 8*j)));
+        }
+    }
+    sum[0] = vaddq_f16(sum[0], sum[2]);
+    sum[1] = vaddq_f16(sum[1], sum[3]);
+    return vaddq_f16(sum[0], sum[1]);
