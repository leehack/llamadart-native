+// no src1 precision request use the FP16 kernels, as before ggml-org/llama.cpp#31854.
+static inline bool ggml_mul_mat_src1_as_f16(const struct ggml_tensor * dst) {
+    GGML_ASSERT(dst->src[0]->type < GGML_TYPE_COUNT && "llamadart F16 matmul route");
+#if defined(__ARM_FEATURE_FP16_VECTOR_ARITHMETIC) && !defined(_MSC_VER)
+    const enum ggml_prec prec = ggml_prec_get_src(dst, 1);
+    // conv ops call mul_mat on a tensor without an op, with src1 in their own work buffer: those keep F32
+    return dst->op == GGML_OP_MUL_MAT &&
+           dst->src[0]->type == GGML_TYPE_F16 && dst->src[1]->type == GGML_TYPE_F32 &&
+           (prec == GGML_PREC_UNDEFINED || prec == GGML_PREC_F16);
+#else
+    (void) dst;
+    return false;
+#endif
+}
